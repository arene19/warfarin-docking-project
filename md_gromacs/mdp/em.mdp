; Energy minimization — use after CHARMM-GUI solvated system is converted to GROMACS
; Merge with CHARMM-GUI topol.top; position restraints on protein/ligand heavy atoms recommended

integrator          = steep
emtol               = 500.0
emstep              = 0.001
nsteps              = 50000
nstlist             = 10
cutoff-scheme       = Verlet
rlist               = 1.2
rcoulomb            = 1.2
rvdw                = 1.2
coulombtype         = PME
pme_order           = 4
fourierspacing      = 0.12
pbc                 = xyz
constraints         = h-bonds
constraint_algorithm = lincs

; GPU (GROMACS 2023+)
nbgpu               = yes
